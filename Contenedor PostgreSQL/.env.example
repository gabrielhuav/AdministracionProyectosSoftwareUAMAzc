# Copia este archivo como «.env» y cambia la contraseña.
#   Símbolo del sistema:  copy .env.example .env
#   Windows PowerShell:   Copy-Item .env.example .env
#   Git Bash / macOS:     cp .env.example .env
#
# Sin el .env, «docker compose up -d» se detiene de inmediato y dice
# qué variable falta. No construye ni arranca nada.
#
# El .env NO se sube al repositorio (está en .gitignore).
# El .env.example SÍ se sube: es el que le dice al equipo qué variables hacen falta.

POSTGRES_DB=proyecto
POSTGRES_USER=proyecto

# Cámbiala. No uses «postgres» ni «1234».
POSTGRES_PASSWORD=cambia-esta-contrasena

# Puerto en TU máquina. Cámbialo si sale «port is already allocated»
# (por ejemplo si ya tienes un PostgreSQL instalado en el 5432).
POSTGRES_PORT=5434

# Puerto de la interfaz web Adminer.
ADMINER_PORT=8080
